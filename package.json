{
  "name": "file-share",
  "version": "1.0.0",
  "private": true,
  "description": "Decentralized file sharing app",
  "author": "Testimony Akinlabi",
  "main": "public/electron.js",
  "homepage": "/",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && xcopy /E /Y build server\\build\\ /I",
    "electron": "electron .",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.fileshare.desktop",
    "productName": "FileShare",
    "files": [
      "public/electron.js"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "binaries",
        "to": "binaries"
      }
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-scripts": "5.0.1",
    "react-router-dom": "^6.0.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.6.4"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}